# Overrides for running api/worker/web on the host (`make api`, `make worker`, ...)
# against the compose backing services (`make infra`).
#
# .env.example uses Docker service names (postgres, redis, minio), which only
# resolve inside the compose network. From the host those services are reached
# via the published ports on localhost. Anything not set here falls back to the
# defaults in apps/*/src/config.py, which already target localhost.
#
#   cp .env.local.example .env.local

DATABASE_URL=postgresql+asyncpg://changeradar:changeradar@localhost:5432/changeradar
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=changeradar
S3_SECRET_KEY=changeradar-secret
S3_BUCKET=changeradar-snapshots

CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK=false
