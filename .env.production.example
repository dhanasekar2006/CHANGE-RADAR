# Production settings for docker-compose.prod.yml.
#   cp .env.production.example .env.production
# Run compose with:  --env-file .env.production
# Generate each secret with:  openssl rand -hex 32
# (hex only: these are embedded in connection URLs, so avoid @ : / # % characters)

# --- Site ---
# Your public hostname, no scheme. DNS (and www.<domain>) must point at this server.
DOMAIN=example.com
LOG_LEVEL=INFO

# --- Auth ---
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database (hostnames/URLs are assembled by docker-compose.prod.yml) ---
POSTGRES_USER=changeradar
POSTGRES_PASSWORD=
POSTGRES_DB=changeradar

# --- Object storage (bundled MinIO) ---
S3_ACCESS_KEY=changeradar
S3_SECRET_KEY=
S3_BUCKET=changeradar-snapshots
S3_REGION=us-east-1

# --- AI scoring (optional; falls back to similarity score when blank) ---
ANTHROPIC_API_KEY=

# --- Price tracking (VilaiWatch) ---
PRICE_CHECK_INTERVAL_SECONDS=1800
# Use a real contact URL for your site.
PRICE_USER_AGENT=VilaiWatchBot/1.0 (+https://example.com/bot; price comparison)
# Empty: the "demo" adapter must not be able to fetch internal hosts in production.
DEMO_STORE_HOSTS=
# Real stores read via structured data, e.g. examplemart=examplemart.in (see docs/price-tracking.md).
# Only list stores whose terms allow automated price checks.
PRICE_JSONLD_STORES=

# --- Email / chat alerts (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
# WhatsApp price-drop alerts (Meta WhatsApp Cloud API). Use a permanent System User token, not the
# 24-hour test token, and an approved template (4 body variables: product, new price, store, link).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v25.0
