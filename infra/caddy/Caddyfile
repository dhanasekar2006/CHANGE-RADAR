# Public edge for the single-server deployment (docker-compose.prod.yml).
# Caddy obtains and renews the Let's Encrypt certificate for $DOMAIN automatically;
# DNS for $DOMAIN must point at this server and ports 80/443 must be open.
# WebSocket upgrades (/api/ws/prices) are proxied without extra config.

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The API serves routes at the root, so strip the /api prefix.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:80
	}
}

# Send www.<domain> to the apex domain.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
