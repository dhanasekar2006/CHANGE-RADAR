# Copy to .env for `docker compose up`. Hostnames below (postgres, redis, minio)
# are Docker service names and only resolve inside the compose network.
# Running api/worker on the host instead? Use .env.local.example (localhost hosts).

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Database ---
POSTGRES_USER=changeradar
POSTGRES_PASSWORD=changeradar
POSTGRES_DB=changeradar
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://changeradar:changeradar@postgres:5432/changeradar

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (S3-compatible / MinIO) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=changeradar
S3_SECRET_KEY=changeradar-secret
S3_BUCKET=changeradar-snapshots
S3_REGION=us-east-1

# --- AI scoring ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Price tracking (VilaiWatch) ---
# How often each listing is re-checked. Lower it (e.g. 30) to demo live updates.
PRICE_CHECK_INTERVAL_SECONDS=1800
PRICE_USER_AGENT=VilaiWatchBot/1.0 (+https://vilaiwatch.example/bot; price comparison)
# Hosts the "demo" adapter may fetch (also gates URLs submitted via POST /products/track).
DEMO_STORE_HOSTS=localhost,127.0.0.1,host.docker.internal
# Real stores read through their schema.org / Open Graph price data: key=host, comma separated
# (join several hosts of one store with |). Empty = demo store only. See docs/price-tracking.md.
PRICE_JSONLD_STORES=
# Alert delivery: SMTP_* below for email; set the bot token for Telegram alerts.

# --- Notification channels ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notifications@changeradar.local

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

TELEGRAM_BOT_TOKEN=

# WhatsApp price-drop alerts via Meta's WhatsApp Cloud API. Blank = WhatsApp alerts are skipped.
# Setup steps are in docs/price-tracking.md ("Price-drop alerts").
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# An approved template whose body has 4 variables: {{1}} product, {{2}} new price, {{3}} store, {{4}} link.
# Blank = send plain text, which WhatsApp only delivers within 24 hours of the person messaging your number.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v25.0

# --- Web ---
# Build-time: docker compose passes this to the web image as a build arg, so
# changing it requires `docker compose build web`.
VITE_API_BASE_URL=http://localhost:8000
# "true" runs VilaiWatch on built-in demo data, no backend needed.
VITE_USE_MOCK=false
